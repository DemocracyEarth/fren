{
  "name": "fren",
  "version": "0.1.0",
  "private": true,
  "description": "fren — a minimal ambient AI companion that lives on your desktop (macOS proof of concept)",
  "main": "apps/desktop/main/index.js",
  "scripts": {
    "start": "node start.js",
    "gateway": "node apps/gateway/server.js",
    "desktop": "electron apps/desktop",
    "test": "npm run lint --silent && node --test \"packages/shared/test/*.test.js\" \"packages/runtime/test/*.test.js\" \"packages/runtime-mock/test/*.test.js\" \"packages/runtime-nanoclaw/test/*.test.js\" \"packages/fren-core/test/*.test.js\" \"packages/observer/test/*.test.js\" \"packages/permissions/test/*.test.js\" \"packages/memory/test/*.test.js\" \"packages/intelligence/test/*.test.js\" \"apps/gateway/test/*.test.js\" \"apps/desktop/test/*.test.js\" \"apps/browser-extension/test/*.test.js\" \"scripts/test/*.test.js\"",
    "runtime:build": "node scripts/runtime-build.js",
    "runtime:check": "node scripts/nanoclaw-overlay-check.js",
    "fetch-node": "node scripts/fetch-node.js",
    "pack": "node scripts/pack-app.js",
    "agent:sync": "node scripts/agent-sync.js",
    "lint": "eslint . --quiet"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@picovoice/pvrecorder-node": "^1.2.9",
    "onnxruntime-node": "^1.29.0",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@elevenlabs/client": "^1.25.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "three": "^0.185.1"
  },
  "build": {
    "appId": "earth.democracy.fren",
    "productName": "fren",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-app",
      "buildResources": "packaging/build-resources"
    },
    "files": [
      "package.json",
      "start.js",
      "apps/**/*",
      "packages/**/*",
      "vendor/nanoclaw/package.json",
      "vendor/nanoclaw/dist/**/*",
      "vendor/nanoclaw/container/**/*",
      "!vendor/nanoclaw/container/agent-runner/node_modules/**/*",
      {
        "from": "packaging/host-prod/node_modules",
        "to": "vendor/nanoclaw/node_modules"
      },
      {
        "from": "packaging/runner-prod/node_modules",
        "to": "vendor/nanoclaw/container/agent-runner/node_modules"
      },
      "!**/test/**",
      "!**/*.test.js",
      "!**/*.test.ts",
      "!**/.git/**",
      "!**/*.map",
      "!vendor/nanoclaw/src/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**/*",
      "!node_modules/sherpa-onnx-darwin-x64/**/*",
      "!node_modules/sherpa-onnx-linux-x64/**/*",
      "!node_modules/sherpa-onnx-linux-arm64/**/*",
      "!node_modules/sherpa-onnx-win-x64/**/*",
      "!node_modules/sherpa-onnx-win-ia32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.29.0.dylib",
      "!node_modules/sherpa-onnx-darwin-arm64/libsherpa-onnx-cxx-api.dylib",
      "!node_modules/@picovoice/pvrecorder-node/lib/linux/**/*",
      "!node_modules/@picovoice/pvrecorder-node/lib/raspberry-pi/**/*",
      "!node_modules/@picovoice/pvrecorder-node/lib/windows/**/*",
      "!node_modules/@picovoice/pvrecorder-node/lib/mac/x86_64/**/*"
    ],
    "extraResources": [
      {
        "from": "packaging/node",
        "to": "node"
      }
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "packaging/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "fren listens for \"hey fren\" on this Mac, only while its light is on. Nothing you say leaves the machine until you open a conversation."
      }
    }
  }
}
