# fren environment. Copy to `.env` at the repo root. Everything is optional in dev.

# API keys are used by the LOCAL GATEWAY only — they never reach the desktop app,
# which deletes them from its own environment at startup.
#
# Set ONE of these. If both are present, DeepSeek wins.
# DeepSeek: https://platform.deepseek.com  (key looks like sk-...)
DEEPSEEK_API_KEY=

# Anthropic: https://console.anthropic.com  (key looks like sk-ant-...)
# Optional if you are logged in via `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=

# Which model to use. Leave EMPTY to let the chosen provider pick its own
# default (deepseek-chat, or claude-haiku-4-5). Only set this to override —
# and make sure the name matches the provider you're actually using.
FREN_MODEL=

# Force the provider: "deepseek", "anthropic", or "mock". Leave empty to pick
# automatically from whichever key is set (DeepSeek first), falling back to the
# offline mock when there is no key at all.
FREN_LLM_PROVIDER=

# Shared secret between desktop app and gateway (dev default: dev-token).
FREN_GATEWAY_TOKEN=

# Where the desktop app finds the gateway (dev default: http://127.0.0.1:4519).
FREN_GATEWAY_URL=

# ---------------------------------------------------------------- VOICE ----
# fren speaks with ElevenLabs. Optional — without a key it stays silent and
# replies in text only. The reply TEXT is what crosses the network here.
# https://elevenlabs.io  ->  Profile -> API key
ELEVENLABS_API_KEY=

# Voice and model are configurable because ElevenLabs revises these IDs.
# If a request 404s, set them here rather than editing code.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# fren LISTENS locally: push-to-talk audio is transcribed by whisper.cpp on
# this machine and never leaves it. Install with:  brew install whisper-cpp
# then download a model, e.g.
#   mkdir -p ~/.cache/whisper.cpp && curl -L -o ~/.cache/whisper.cpp/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# Both are auto-detected; set them only to override.
FREN_WHISPER_BIN=
FREN_WHISPER_MODEL=
# Spoken language, or "auto" (default).
FREN_WHISPER_LANG=
