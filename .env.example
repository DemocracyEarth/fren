# fren environment. Copy to `.env` at the repo root. Everything is optional in dev.

# Anthropic API key used by the LOCAL GATEWAY only — never reaches the desktop client.
# Optional if you are logged in via `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=

# Model the gateway uses. Cheap by default; swap without touching the desktop app.
FREN_MODEL=claude-haiku-4-5

# Force the gateway LLM provider: "anthropic" or "mock". Default: anthropic,
# falling back to mock when the SDK or credentials are unavailable.
FREN_LLM_PROVIDER=

# Shared secret between desktop app and gateway (dev default: dev-token).
FREN_GATEWAY_TOKEN=

# Where the desktop app finds the gateway (dev default: http://127.0.0.1:4519).
FREN_GATEWAY_URL=
