{
  "manifest_version": 3,
  "name": "fren browser awareness",
  "version": "0.1.1",
  "description": "Lets fren, running on this computer, see what you are reading. Sends nothing anywhere except to fren on this machine.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
