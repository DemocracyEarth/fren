node_modules/
.env
*.log
.DS_Store

# Benchmark scratch: copies of face.js at other commits, generated on demand.
dev/bench/face-*.js
dev/bench/svg-*.html

# The vendored runtime's per-install state and build output. Its own
# .gitignore says the same; this is so nobody has to know that.
vendor/nanoclaw/node_modules/
vendor/nanoclaw/dist/
vendor/nanoclaw/data/
vendor/nanoclaw/groups/*
vendor/nanoclaw/logs/
vendor/nanoclaw/store/
vendor/nanoclaw/.env

# Packaging: the bundled stock Node (fetched by scripts/fetch-node.js), the icon's
# intermediate render (scripts/make-icon.js keeps the .icns), and the built app.
packaging/node
packaging/icon-1024.png
packaging/host-prod/
packaging/runner-prod/
dist-app/
